USE [BOOKING-HOTEL];
GO

CREATE VIEW vw_RoomTypeOverview
AS
SELECT
    rt.id AS room_type_id,
    rt.hotel_id,
    h.name AS hotel_name,
    rt.name AS room_type_name,
    rt.capacity,
    rt.total_rooms,
    rt.base_price,
    rt.description,
    COUNT(DISTINCT rti.id) AS total_images

FROM room_types rt

INNER JOIN hotels h
    ON rt.hotel_id = h.id

LEFT JOIN room_type_images rti
    ON rt.id = rti.room_type_id

GROUP BY
    rt.id,
    rt.hotel_id,
    h.name,
    rt.name,
    rt.capacity,
    rt.total_rooms,
    rt.base_price,
    rt.description;
GO